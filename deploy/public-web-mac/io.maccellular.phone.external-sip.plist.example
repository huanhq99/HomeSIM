<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.maccellular.phone</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>__DJONEHUB_BINARY__</string>
    <string>-listen</string>
    <string>127.0.0.1:7576</string>
    <string>-usb-at-only</string>
    <string>-sms-only-runtime</string>
    <string>-public-web-listen</string>
    <string>127.0.0.1:7578</string>
    <string>-public-web-host</string>
    <string>__PUBLIC_WEB_HOST__</string>
    <string>-public-web-access-team-domain</string>
    <string>__CLOUDFLARE_TEAM_DOMAIN__</string>
    <string>-public-web-access-audience</string>
    <string>__CLOUDFLARE_ACCESS_AUD__</string>
    <string>-public-web-access-allowed-email-file</string>
    <string>__ALLOWED_EMAILS_FILE__</string>
    <string>-sms-store</string>
    <string>__SMS_STORE_DIR__</string>
    <string>-public-web-control</string>
    <string>-public-web-external-voice</string>
    <string>-public-web-turn-host</string>
    <string>__TURN_HOST__</string>
    <string>-public-web-turn-secret-file</string>
    <string>__TURN_SECRET_FILE__</string>
    <string>-public-web-turn-udp-port</string>
    <string>3478</string>
    <string>-public-web-turn-tls-port</string>
    <string>443</string>
    <string>-public-web-turn-credential-ttl</string>
    <string>5m</string>
    <string>-public-web-push</string>
    <string>-public-web-push-vapid-private-key-file</string>
    <string>__VAPID_PRIVATE_KEY_FILE__</string>
    <string>-public-web-push-vapid-subject</string>
    <string>__PUSH_SUBJECT__</string>
    <string>-public-web-push-subscriptions-file</string>
    <string>__PUSH_SUBSCRIPTIONS_FILE__</string>
    <string>-voice-provider</string>
    <string>asterisk</string>
    <string>-voice-gateway-id</string>
    <string>__VOICE_GATEWAY_ID__</string>
    <string>-asterisk-ari-url</string>
    <string>http://127.0.0.1:__ASTERISK_ARI_PORT__/ari</string>
    <string>-asterisk-ari-application</string>
    <string>__ASTERISK_APPLICATION__</string>
    <string>-asterisk-ari-incoming-argument</string>
    <string>__ASTERISK_ARGUMENT__</string>
    <string>-asterisk-ari-incoming-context</string>
    <string>__ASTERISK_CONTEXT__</string>
    <string>-asterisk-ari-incoming-endpoint</string>
    <string>__ASTERISK_ENDPOINT__</string>
    <string>-asterisk-ari-outgoing-endpoint</string>
    <string>__ASTERISK_OUTGOING_ENDPOINT__</string>
    <string>-asterisk-expected-entity-id</string>
    <string>__ASTERISK_ENTITY_ID__</string>
    <string>-asterisk-expected-version</string>
    <string>__ASTERISK_VERSION__</string>
    <string>-asterisk-incoming-policy-id</string>
    <string>__ASTERISK_POLICY_ID__</string>
    <string>-asterisk-ari-username</string>
    <string>__ASTERISK_CONTROL_USER__</string>
    <string>-asterisk-ari-password-file</string>
    <string>__ASTERISK_CONTROL_PASSWORD_FILE__</string>
    <string>-asterisk-recovery-ari-username</string>
    <string>__ASTERISK_INSPECT_USER__</string>
    <string>-asterisk-recovery-ari-password-file</string>
    <string>__ASTERISK_INSPECT_PASSWORD_FILE__</string>
    <string>-sip-recovery-store</string>
    <string>__SIP_RECOVERY_STORE__</string>
    <string>-sip-media-udp-min</string>
    <string>__SIP_MEDIA_UDP_MIN__</string>
    <string>-sip-media-udp-max</string>
    <string>__SIP_MEDIA_UDP_MAX__</string>
    <string>-sip-answer-incoming</string>
    <string>-sip-reject-incoming</string>
    <string>-sip-send-dtmf</string>
    <string>-sip-end-active</string>
    <string>-sip-dial-outgoing=__SIP_DIAL_OUTGOING__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/djonehub-public-web.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/djonehub-public-web.log</string>
</dict>
</plist>
