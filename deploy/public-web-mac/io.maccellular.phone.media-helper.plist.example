<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.maccellular.phone.media-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MEDIA_HELPER_BINARY__</string>
    <string>--remote-media-helper</string>
    <string>--base-url</string>
    <string>http://127.0.0.1:7576/</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/djonehub-media-helper.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/djonehub-media-helper.log</string>
</dict>
</plist>
