listening-port=3478
tls-listening-port=5349
external-ip=43.142.48.100
realm=homesim
use-auth-secret
# Replace inside a root-only config; use the SAME secret on NAS, never commit it.
static-auth-secret=REPLACE_WITH_RANDOM_SECRET
cert=/run/tls/cert.pem
pkey=/run/tls/key.pem
min-port=20000
max-port=20100
fingerprint
no-multicast-peers
no-tcp-relay
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
stale-nonce=600
total-quota=20
user-quota=4
max-bps=128000
pidfile=/tmp/coturn.pid
log-file=stdout
