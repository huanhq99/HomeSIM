HOMESIM_TTY=/dev/serial/by-id/usb-BAIWANG_Baiwang-if02-port0
HOMESIM_AUDIO_DEVICE=hw:Baiwang,0
# Set to the LAN address of your own NAS for direct LAN access.
HOMESIM_BIND_IP=127.0.0.1
# Set only when using your own trusted reverse proxy that overwrites this header.
HOMESIM_TRUST_PROXY=0
# Optional authenticated TURN; set a private shared secret only after deployment.
HOMESIM_TURN_URLS=
HOMESIM_TURN_SECRET=
HOMESIM_FORCE_RELAY=0
