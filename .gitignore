# These are source class names, not SIM EID exports. Keep the broad privacy
# exclusion above while ensuring a normal `git add` cannot omit required code.
!android/native-client/src/main/java/org/maccellular/gateway/nativeclient/DeviceIdentity.java
!android/native-client/src/test/java/org/maccellular/gateway/nativeclient/DeviceIdentityTest.java

